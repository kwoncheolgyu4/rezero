package com.zero.re.member.controller;

import javax.servlet.http.Cookie;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.ResponseBody;
import com.zero.re.member.service.MemberService;
import com.zero.re.member.vo.MemberVO;

@Controller
public class MemberController {

	@Autowired
	MemberService memberService;

	@ResponseBody
	@RequestMapping("/login")
	public MemberVO memLogin(@RequestBody MemberVO vo, boolean remember, HttpSession session,
			HttpServletResponse response) {
		System.out.println(vo);
		MemberVO login = memberService.memLogin(vo);

		if (login != null) {
			session.setAttribute("login", login);
			if (remember) {
				// 쿠키 생성
				Cookie cookie = new Cookie("rememberId", login.getId());
				response.addCookie(cookie);

			} else {
				// 쿠키 삭제
				// 동일한 key 값을 가지는 쿠키의 유효시간을 0으로
				Cookie cookie = new Cookie("rememberId", "");
				cookie.setMaxAge(0);
				response.addCookie(cookie);
			}
		}

		System.out.println("Session login: " + session.getAttribute("login"));
		return login;
	};

	@ResponseBody
	@RequestMapping("/regist")
	public MemberVO memRegist(@RequestBody MemberVO vo, HttpSession session) {

		memberService.memRegist(vo);

		MemberVO login = memberService.memLogin(vo);

		session.setAttribute("login", login);

		return login;
	}

	// 아이디 중복체크
	@RequestMapping("/idCheck")
	@ResponseBody
	public int idCheck(@RequestParam("id") String id) {
		int cnt = memberService.idCheck(id);
		return cnt;
	}
	
	@RequestMapping("/update")
	@ResponseBody
	public MemberVO memUpdate(@RequestBody MemberVO vo, HttpSession session) {
		
		memberService.memUpdate(vo);
		
		MemberVO login = memberService.memLogin(vo);
		
		session.setAttribute("login", login);
		
		System.out.println(login);
		
		return vo;
	}
	
	@RequestMapping("/logout")
	@ResponseBody
	public String memLogout(HttpSession session) {
		session.invalidate();
		
		return "success";
	}
	
	@RequestMapping("/exit")
	@ResponseBody
	public String memExit(@RequestParam ("id") String id,HttpSession session) {
		session.invalidate();
		
		memberService.memExit(id);
		
		return "success";
	}
}
