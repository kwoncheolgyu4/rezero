										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">대전시 평균</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">73,385</td>
									</tr>
									<tr role="row" id="2" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center; display: none;"
											aria-describedby="gridSeoul2_USE_YM" scope="row">202402</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">서구</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">117,683</td>
									</tr>
									<tr role="row" id="3" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_USE_YM" scope="row" rowspan="2">202403</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">대전시 평균</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">65,372</td>
									</tr>
									<tr role="row" id="4" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center; display: none;"
											aria-describedby="gridSeoul2_USE_YM" scope="row">202403</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">서구</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">106,037</td>
									</tr>
									<tr role="row" id="5" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_USE_YM" scope="row" rowspan="2">202404</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">대전시 평균</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">61,845</td>
									</tr>
									<tr role="row" id="6" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center; display: none;"
											aria-describedby="gridSeoul2_USE_YM" scope="row">202404</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">서구</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">103,082</td>
									</tr>
									<tr role="row" id="7" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_USE_YM" scope="row" rowspan="2">202405</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">대전시 평균</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">59,430</td>
									</tr>
									<tr role="row" id="8" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center; display: none;"
											aria-describedby="gridSeoul2_USE_YM" scope="row">202405</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">서구</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">101,096</td>
									</tr>
									<tr role="row" id="9" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_USE_YM" scope="row" rowspan="2">202406</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">대전시 평균</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">67,063</td>
									</tr>
									<tr role="row" id="10" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center; display: none;"
											aria-describedby="gridSeoul2_USE_YM" scope="row">202406</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">서구</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">113,572</td>
									</tr>
									<tr role="row" id="11" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_USE_YM" scope="row" rowspan="2">202407</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">대전시 평균</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">79,897</td>
									</tr>
									<tr role="row" id="12" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
										<td role="gridcell" style="text-align: center; display: none;"
											aria-describedby="gridSeoul2_USE_YM" scope="row">202407</td>
										<td role="gridcell" style="text-align: center;"
											aria-describedby="gridSeoul2_SIG_NM" scope="row">서구</td>
										<td role="gridcell" style="text-align: right;"
											aria-describedby="gridSeoul2_POWER_ENERGY_USAGE" scope="row">132,521</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<!-- 사용자 섹션 -->
				<div
					class="third-rectangle d-flex justify-content-center align-items-center position-relative">
				<!-- 사용자 주소 -->
                <div class="Rectangle-10 d-flex align-items-center" style="top: 40px; left: 725px;">
                    <!-- 아이콘 -->
                    <img src="resources/icon/hotel-fill@3x.png" alt="Address Icon" class="address-icon">
                    <!-- 텍스트 -->
                    <span class="styled-text-7">주소</span>
                    <!-- 말풍선 -->
                    <c:if test="${sessionScope.login == null}">
                    	<div class="tooltip-1" style="display: none;">${sessionScope.login.address}</div>
                    </c:if>
                    <c:if test="${sessionScope.login != null}">
                    	<div class="tooltip-1">${sessionScope.login.address}</div>
                    </c:if>
                </div>
					<!-- 아이콘과 텍스트 (외부 네모에 위치) -->
					<div class="d-flex align-items-center justify-content-between position-absolute"
						style="top: 20px; left: 24px; width:830px">
						<div class="d-flex align-items-center">
							<img src="resources/icon/footprint-fill@3x.png" class="Chart"
								alt="Chart Icon"> <span class="text-mystyle-3 ms-3">
								<c:if test="${sessionScope.login == null}">
								<span class="text-mystyle-4 text-background" id="nonLoginId">사용자</span>
								님의 에너지 사용량
								</c:if>
								<c:if test="${sessionScope.login != null}">
								<span class="text-mystyle-4 text-background">${sessionScope.login.id}</span>
								님의 에너지 사용량
								</c:if>
							</span>
						</div>
					</div>
					<!-- 내부 네모칸 -->
					<div class="Rectangle-4 position-absolute d-flex"
						style="top: 86px; left: 20px; right: 20px; bottom: 20px;">
						<!-- 내부 내용 추가 가능 -->
						<div class="w-50 h-100 bg-green" style="text-align: center;">
							<span style="display: block; margin-top: 20px; color: #020606 !important;">에너지 사용량</span>
							<canvas class="my-2" id="doughnut-chart1" height="280px" width="240px" style="margin: 0px auto"></canvas>
						</div>
						<div class="w-50 h-100 bg-blue" style="text-align: center;">
							<span style="display: block; margin-top: 20px; color: #020606 !important;">온실가스 배출량</span>
							<canvas class="my-2" id="doughnut-chart2" height="280px" width="240px" style="margin: 0px auto"></canvas>
						</div>
						<!-- 블러 처리된 오버레이 -->
						<c:if test="${sessionScope.login == null}">
					    <div class="blur-overlay" id="blurOverlay">
					        <div class="message-box">
					            <p class="blur-message">우리 건물 에너지 사용량이 궁금하다면?</p>
					            <button class="btn btn-login" onclick="redirectToLogin()">로그인 후 확인하기</button>
					        </div>
					    </div>
					    </c:if>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Footer -->
	<footer>
		<p class="footer">© 2024 우주 최강팀 리제로</p>
	</footer>

	<script type="text/javascript">
	
	window.addEventListener('load', function() {
	// 	console.log($('#year').val());
	// 	console.log($('#region').text());
	// 	console.log('load 완료');
	});
	
	mapView = document.getElementById('map-view');
    backButton = document.getElementById('back-button');
    let selectCode;

    function showDongMap(dongSvgFile) {
        mapView.setAttribute('data', dongSvgFile);
        backButton.style.display = 'block';
    }

    function showGuMap() {
        mapView.setAttribute('data', 'resources/static/daejeon_map_gu_ref_ref.html');
        selectCode = null;
        backButton.style.display = 'none';
    }
    
    function showGu(e){
    	let name = e.getAttribute('data-name');
		$('#region').text(name);
    }
    
    function showDong(e){
    	let name = e.getAttribute('data-name');
    	code = e.getAttribute('id');
    	
    	svgDoc = mapView.contentDocument;
    	
         // id로 직접 찾기
        element = svgDoc.getElementById(code); // '#' 없이 id만 사용
        
        if (selectCode){
   	 		svgDoc.getElementById(selectCode).style.fill = '#7bc1c2';
        }
        
        if (element) {
            element.style.fill = '#286E71';
        }
        
        selectCode = code;
        
		$('#region').text(name);
    }
	
	new Chart(document.getElementById("line-chart"), {
	    type: 'line',
	    data: {
	        labels: [2406, 2407, 2408, 2409, 2410, 2411],
	        datasets: [
	            {
	                data: [400, 114, 106, 106, 107, 111],
	                label: "대전시 평균",
	                borderColor: "#5aa5a7",
	                fill: "start",
	                backgroundColor: "rgba(90, 165, 167, 0.2)",
	                pointHoverRadius: 7,  // hover 시 Point 크기 증가
	                borderWidth: 4,  // 기본 선 두께
	                hoverBorderWidth: 4  // 호버 시 선 두께
	            },
	            {
	                data: [282, 350, 411, 502, 635, 809],
	                label: "서구",
	                borderColor: "#e871ae",
	                fill: "start",
	                backgroundColor: "rgba(255, 208, 232, 0.2)",
                    pointHoverRadius: 7,  // hover 시 Point 크기 증가
                    borderWidth: 4,  // 기본 선 두께
                    hoverBorderWidth: 4,  // 호버 시 선 두께
                    borderDash: [15, 5]
	            }
	        ]
	    },
	    options: {
	    	responsive: true,
            maintainAspectRatio: false,
            interaction: {
                intersect: false,
                mode: 'index'
            },
	        plugins: {
	            legend: {
	                display: true,
	                labels: {
	                	 usePointStyle: true,
	                	 pointStyle: 'line',  // 'dash' 대신 'line' 사용
	                     font: {
	                         size: 16,
	                     },
	                     padding: 15,
	                     generateLabels: (chart) => {
	                         const labels = Chart.defaults.plugins.legend.labels.generateLabels(chart);
	                         for (const key in labels) {
	                             const target = Number(key);
	                             if (target === 0) {
	                                 labels[key].text = '대전시 평균';
	                             } else if (target === 1) {
	                                 labels[key].text = '서구';
	                             }
	                         }
	                         return labels;
	                     }
	                }
	            },
	            tooltip: {
	                borderWidth: 1,
	                borderColor: '#eeeeee',
	                backgroundColor: '#ffffff',
	                padding: 10,
	                bodySpacing: 10,
	                titleColor: '#595959',
	                usePointStyle: true,
	                pointStyle: 'circle',
	                boxPadding: 5,
	                boxWidth: 10,
	                boxHeight: 10,
	                bodyColor: '#595959',
	                font: {
	                    size: 12
	                },
	                caretSize: 0,
	                // 툴팁 내 레이블 색상 변경
	                callbacks: {
	                    labelColor: (tooltipItem) => {
	                        if (tooltipItem.datasetIndex === 0) {
	                            return {
	                                borderColor: '#5aa5a7',
	                                backgroundColor: '#5aa5a7'
	                            };
	                        }
	                        if (tooltipItem.datasetIndex === 1) {
	                            return {
	                                borderColor: '#e871ae',
	                                backgroundColor: '#e871ae'
	                            };
	                        }
	                    },
	                },
	            	 // 툴팁 아이템 정렬 추가
	                itemSort: (a, b) => b.raw - a.raw
	            }
	        },
	        scales: {
	            x: {
	                ticks: {
	                    font: {
	                        size: 16
	                    }
	                }
	            },
	            y: {
	                ticks: {
	                    font: {
	                        size: 16
	                    }
	                }
	            }
	        }
	    }
	});

		
		new Chart(document.getElementById("doughnut-chart1"), {
			type : 'doughnut',
			data : {
					  labels: [
					    '전기',
					    '가스',
					  ],
					  datasets: [{
					    data: [300, 50],
					    backgroundColor: [
					      '#e871ae',
					      '#5aa5a7'
					    ],
					    hoverOffset: 4
			  	}]
			},
			options:{
				plugins:{
					legend: {
		                display: true,
		                labels: {
		                    padding: 20,
		                    usePointStyle: true,
		                    pointStyle: 'circle',
		                    boxWidth: 20,
		                    boxHeight: 20,
		                    font: {
		                        size: 16
		                    },
		                }
		            },
		            tooltip: {
		                borderWidth: 1,
		                borderColor: '#eeeeee',
		                backgroundColor: '#ffffff',
		                padding: 10,
		                bodySpacing: 10,
		                titleColor: '#595959',
		                usePointStyle: true,
		                pointStyle: 'circle',
		                boxPadding: 5,
		                boxWidth: 10,
		                boxHeight: 10,
		                bodyColor: '#595959',
		                font: {
		                    size: 12
		                },
		                caretSize: 0,
		                // 툴팁 내 레이블 색상 변경
		                callbacks: {
		                    labelColor: (tooltipItem) => {
		                        if (tooltipItem.datasetIndex === 0) {
		                            return {
		                                borderColor: '#5aa5a7',
		                                backgroundColor: '#5aa5a7'
		                            };
		                        }
		                        if (tooltipItem.datasetIndex === 1) {
		                            return {
		                                borderColor: '#e871ae',
		                                backgroundColor: '#e871ae'
		                            };
		                        }
		                    },
		                }
		            }
				}
			}
		});
		
