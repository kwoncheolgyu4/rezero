<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ include file="../inc/header.jsp"%>
<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="utf-8" />
<meta name="viewport"
	content="width=device-width, initial-scale=1, shrink-to-fit=no" />
<title>메인</title>

<style type="text/css">
#map-container {
	margin-top: 100px; /* 브라우저 기본 여백 제거 */
	margin-left: 20px;
   	padding: 0;
	width: 90%; /* 화면 전체 너비 */
	height: 80%; /* 화면 전체 높이 */
	display: flex;
	justify-content: center;
	align-items: center;
	/* background-color: #f0f0f0; */
}

svg, object {
	width: 100%; /* 컨테이너의 100% */
	height: 100%; /* 컨테이너의 100% */
	display: block; /* 블록 요소로 설정 */
}

#back-button {
	position: absolute;
	right: 20px;
	top: 40px;
	color: white;
	border: none;
	padding: 10px 20px;
	cursor: pointer;
	font-size: 16px;
	display: none; /* 초기에는 숨김 */
	filter: brightness(1.1); /* 밝기를 20% 증가 */
	transition: opacity 0.3s ease; /* 부드러운 전환 효과 */
	opacity: 0.8; /* 기본 불투명도 */
	
}

#back-button:hover {
	opacity: 1; /* 기본 불투명도 */
}

.table {
 }
 

tr > th{
	padding: 4px 8px !important;
	text-align: center;
	vertical-align: middle;
	background-color: #effafb !important;
	border-right:none;
	color: #020606 !important;
}

tr > td{
	padding: 4px 8px !important;
	vertical-align: middle;
	border-right:none;
	color: #020606 !important;
}

tr > td:first-child {
    border-left:none;
}

tr > th:first-child {
    border-left:none;
}

</style>
</head>

<body>

	<!-- Layout -->
    <div class="mt-5 mb-5 d-flex justify-content-center">
        <div class="row">
            <div class="col-md-auto">
			
				<!-- 지도 -->
				<div class="custom-rectangle d-flex justify-content-center align-items-center cu-1" 
				style="background-color: #effafb !important; position: relative;">
					<div class="text-mystyle-2" style="position: absolute; top:40px; left:50px;">대전광역시 에너지 사용량</div>
					<select class="form-select" id="year" style="position: absolute; top:100px; left:46px; width: 24%">
					  <option value="1" selected="selected">2022(하반기)</option>
					  <option value="2">2022(상반기)</option>
					  <option value="3">2021(하반기)</option>
					  <option value="4">2021(상반기)</option>
					  <option value="5">2020(하반기)</option>
					  <option value="6">2020(상반기)</option>
					</select>
				
					<img id="back-button" src="resources/icon/arrow-left.png" alt="구 선택으로 돌아가기" onclick="showGuMap()" style="cursor: pointer;">
					<div id="map-container">
				        <object id="map-view" type="image/svg+xml" data="resources/static/daejeon_map_gu_ref_ref.html"></object>
				    </div>
				</div>

				<!-- 지도 아래 버튼 -->
                <div class="d-flex justify-content-between" style="gap: 12px;">
                    <button class="custom-small-rectangle-2 d-flex align-items-center">
                        <div class="rounded-circle d-flex justify-content-center align-items-center"
                            style="width: 56px; height: 56px; margin-right: 20px;">
                            <img src="resources/icon/search@3x.png" class="community-fill" alt="Icon">
                        </div>
                        			날씨
                    </button>
                </div>
                <div class="d-flex justify-content-between" style="gap: 12px;">
				<button class="custom-small-rectangle d-flex align-items-center" onclick="location.href='${pageContext.request.contextPath}/carbon'">
                        <div class="rounded-circle d-flex justify-content-center align-items-center"
                            style="width: 56px; height: 56px; margin-right: 20px;">
                            <img src="resources/icon/community-fill@3x.png" class="community-fill" alt="Icon">
                        </div>
                        		우리 집 탄소 배출량
                    </button>
                    <button class="custom-small-rectangle d-flex align-items-center" onclick="location.href='${pageContext.request.contextPath}/energy'">
                        <div class="rounded-circle d-flex justify-content-center align-items-center"
                            style="width: 56px; height: 56px; margin-right: 20px;">
                            <img src="resources/icon/lightbulb-flash-line@3x.png" class="community-fill" alt="Icon">
                        </div>
                        		에너지 절약 방법
                    </button>
                </div>
            </div>

			<!-- Right: 차트 위, 데이터 아래 -->
			<div class="col-md d-flex flex-column" style="gap: 24px;">
				<!-- 첫 번째 네모칸 -->
			<div class="second-rectangle position-relative d-flex flex-column" style="padding: 24px;">
					<!-- 상단 아이콘과 텍스트 -->
                    <div class="d-flex align-items-center">
                        <img src="resources/icon/chart@3x.png" class="Chart" alt="Chart Icon">
                        <span class="text-mystyle-1 ms-3">
                            <span class="text-mystyle-2" id="region">서구</span> 에너지 사용량</span></div>
						<!-- 슬라이더 -->
						<div class="slider-container" style="margin-left: 20px;"
						onclick="toggleSlider()">
						<!-- 고정된 텍스트 -->
						<span class="slider-text-left">에너지 사용량</span>
                        <span class="slider-text-right">온실가스 사용량</span>
						<!-- 슬라이드 버튼 -->
                        <div class="slider-button" id="slider-button"></div>
                    </div>
					<!-- 선택된 상태 -->
                    <div class="Rectangle-9 active" style="top: 146px; left: 625px;">
                        <span class="styled-text active-text">데이터</span>
                    </div>

					<!-- 선택되지 않은 상태 -->
					<div class="Rectangle-9" style="top: 146px; left: 725px;">
                        <span class="styled-text inactive-text">예측</span>
                    </div>
					<!-- 전기(MWh) 및 가스(천m³) 버튼 -->
                    <div class="d-flex gap-2" id="button-container" style="margin-left: 20px;">
                        <button id="button1" class="styled-button active">
                            	전기(MWh)
                        </button>
                        <button id="button2" class="styled-button">
                            	가스(천m³)
                        </button>
                    </div>
					<!-- 내부 네모칸 -->
					<div class="Rectangle-4 position-absolute d-flex"
						style="top: 188px; left: 20px; right: 20px; bottom: 20px;">
						<div
							class="w-50 h-100 d-flex align-items-center justify-content-center"
							style="overflow: hidden;">
							<canvas class="mx-3 my-2" id="line-chart" height="280px" width="240px"></canvas>
						</div>
						<div class="w-50 h-100 d-flex align-items-center justify-content-center" style="overflow: hidden;">
							<table class="table table-bordered" style="margin: 0px 4px; margin-right: 16px;">
								<thead class="thst grid2">
									<tr>
										<th width="30px" height="45px" scope="col">년월</th>
										<th width="60px" height="45px" scope="col">구분</th>
										<th width="100px" height="45px" scope="col">전기 에너지 사용량<br>(tCO₂)
										</th>
									</tr>
								</thead>
								<tbody>
									<tr role="row" id="1" tabindex="-1"
										class="ui-widget-content jqgrow ui-row-ltr">
