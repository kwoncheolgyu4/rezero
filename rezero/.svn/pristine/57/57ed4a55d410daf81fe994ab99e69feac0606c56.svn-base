
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta data-name="viewport"
	content="width=device-width, initial-scale=1.0">
<title>중구</title>
<style>
/* 기본 브라우저 여백 제거 */
html, body {
	margin: 0;
	padding: 0;
	overflow: hidden; /* 스크롤 제거 */
}

/* SVG 설정 */
svg {
	width: 800px; /* 화면 전체 너비 */
	height: 600px; /* 화면 전체 높이 */
	background-color: #f0f0f0; /* 배경색 설정 */
}

/* 고정된 층 스타일 */
.fixed-layer path {
	fill: transparent;
	pointer-events: all; /* 이벤트 활성화 */
	cursor: default;
}

/* 움직이는 층 스타일 */
.moving-layer path {
	fill: lightblue;
	stroke: black;
	stroke-width: 0.5;
	transition: transform 0.3s ease, filter 0.3s ease;
}

/* 호버 시 움직이는 층 효과 */
.moving-layer path.hovered {
	transform: translate(-8px, -8px);
	filter: drop-shadow(6px 6px rgba(0, 0, 0, 1))
		drop-shadow(4px 4px rgba(0, 0, 0, 1));
	fill: lightgreen;
}

/* 지도 스타일 */
/* .dong {
            fill: lightblue;
            stroke: black;
            stroke-width: 0.5;
            transform: translate(0, 0);
            filter: drop-shadow(0px 0px 0px rgba(0, 0, 0, 0)); 기본적으로 그림자 없음
            transition: transform 0.3s ease, filter 0.3s ease; 부드러운 효과
        } */

/* 마우스 오버 시 색상 변경 */
/* .dong:hover {
            fill: lightgreen;
            cursor: pointer;
            transform: translate(-8px, -8px);
            filter: drop-shadow(5px 5px rgba(0, 0, 0, 1)) 
                    drop-shadow(4px 4px rgba(0, 0, 0, 1));
        } */

/* 툴팁 스타일 */
.tooltip {
	position: absolute;
	background-color: rgba(0, 0, 0, 0.8);
	color: white;
	padding: 5px 10px;
	border-radius: 4px;
	font-size: 12px;
	pointer-events: none; /* 툴팁이 마우스 이벤트를 차단하지 않음 */
	white-space: nowrap;
	z-index: 10;
	display: none;
}
</style>
</head>
