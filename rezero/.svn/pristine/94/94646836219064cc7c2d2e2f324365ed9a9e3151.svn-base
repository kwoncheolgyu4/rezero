document.addEventListener("DOMContentLoaded", () => {
    const rectangles = document.querySelectorAll(".Rectangle-9");
    const button1 = document.getElementById("button1"); // 첫 번째 버튼
    const button2 = document.getElementById("button2"); // 두 번째 버튼
    const tableHeader = document.querySelector(".thst.grid2 th:last-child");
    const yearSelect = document.getElementById('year');
    
    // 연도 선택 변경 이벤트 리스너
    yearSelect.addEventListener('change', () => {
        updateDataBasedOnSelection();
    });

    rectangles.forEach((rect) => {
        rect.addEventListener("click", () => {
            // 모든 네모를 inactive로 설정
            rectangles.forEach((r) => {
                r.classList.remove("active");
                const textSpan = r.querySelector("span");
                if (textSpan) {
                    textSpan.classList.remove("active-text");
                    textSpan.classList.add("inactive-text");
                }
            });

            // 클릭된 네모를 active로 설정
            rect.classList.add("active");
            const activeTextSpan = rect.querySelector("span");
            if (activeTextSpan) {
                activeTextSpan.classList.remove("inactive-text");
                activeTextSpan.classList.add("active-text");
            }
        });
    });

    // 기본 선택값
    rectangles[0].classList.add("active");
    const defaultTextSpan = rectangles[0].querySelector("span");
    if (defaultTextSpan) {
        defaultTextSpan.classList.remove("inactive-text");
        defaultTextSpan.classList.add("active-text");
    }

    // 버튼 초기 상태 설정
    button1.classList.add("active");

    // 버튼 클릭 이벤트 핸들러 추가
    button1.addEventListener("click", () => {
        setActiveButton(button1, button2);
        updateTableHeader(); // 테이블 헤더 업데이트
        updateDataBasedOnSelection();
    });

    button2.addEventListener("click", () => {
        setActiveButton(button2, button1);
        updateTableHeader(); // 테이블 헤더 업데이트
        updateDataBasedOnSelection();
    });

    function setActiveButton(activeButton, inactiveButton) {
        // 활성화된 버튼 스타일 설정
        activeButton.classList.add("active");
        // 비활성화된 버튼 스타일 제거
        inactiveButton.classList.remove("active");
    }
    
    // 테이블 헤더 업데이트 함수를 전역으로 이동
    window.updateTableHeader = function() {
        const isEnergyUsage = document.getElementById("slider-button").style.left === "0px" || document.getElementById("slider-button").style.left === "";
        const isElectric = document.getElementById("button1").classList.contains("active");
        
        if (isEnergyUsage) {
            if (isElectric) {
                tableHeader.innerHTML = "전기 에너지 사용량<br>(MWh)";
            } else {
                tableHeader.innerHTML = "가스 에너지 사용량<br>(천m³)";
            }
        } else {
            if (isElectric) {
                tableHeader.innerHTML = "전기 온실가스 배출량<br>(tCO₂)";
            } else {
                tableHeader.innerHTML = "가스 온실가스 배출량<br>(tCO₂)";
            }
        }
    };
    
 // 데이터 업데이트 함수도 전역으로 이동
    window.updateDataBasedOnSelection = function() {
        const currentCode = selectCode || selectGu;
        if (!currentCode) return;

        const yearSelect = document.getElementById('year');
        switch (yearSelect.value) {
            case "1": year = 2022; sDate = 7; eDate = 12; break;
            case "2": year = 2022; sDate = 1; eDate = 6; break;
            case "3": year = 2021; sDate = 7; eDate = 12; break;
            case "4": year = 2021; sDate = 1; eDate = 6; break;
            case "5": year = 2020; sDate = 7; eDate = 12; break;
            case "6": year = 2020; sDate = 1; eDate = 6; break;
        }

        const isEnergyMode = document.getElementById("slider-button").style.left === "0px" || document.getElementById("slider-button").style.left === "";
        const isElectricSelected = document.getElementById("button1").classList.contains("active");
        
        const dataField = isEnergyMode ? 
            (isElectricSelected ? 'ele' : 'gas') : 
            (isElectricSelected ? 'eledsa' : 'gasdsa');
            
        const currentRegion = $('#region').text();
        
        const data = {
            'code': currentCode,
            'year': year,
            'sdate': sDate,
            'edate': eDate,
            'dongyn': currentCode.length > 5 ? 'Y' : 'N'
        };
        
        $.ajax({
            type: "post",
            url: "/showEnergy",
            data: JSON.stringify(data),
            contentType: 'application/json;',
            success: function(data) {
                updateChartData(data, dataField, currentRegion);
            },
            error: function(request, status, error) {
                console.log("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
            }
        });
    };
    
    function updateDataOnDateChange() {
        if (selectCode) {
            // 현재 선택된 연도에 따른 날짜 설정
            switch (yearSelect.value) {
                case "1": year = 2022; sDate = 7; eDate = 12; break;
                case "2": year = 2022; sDate = 1; eDate = 6; break;
                case "3": year = 2021; sDate = 7; eDate = 12; break;
                case "4": year = 2021; sDate = 1; eDate = 6; break;
                case "5": year = 2020; sDate = 7; eDate = 12; break;
                case "6": year = 2020; sDate = 1; eDate = 6; break;
            }

            // 현재 선택된 모드와 버튼 상태 확인
            const isEnergyMode = document.getElementById("slider-button").style.left === "0px" || document.getElementById("slider-button").style.left === "";
            const isElectricSelected = document.getElementById("button1").classList.contains("active");
            
            // 현재 상태에 따른 데이터 필드 결정
            const dataField = isEnergyMode ? 
                (isElectricSelected ? 'ele' : 'gas') : 
                (isElectricSelected ? 'eledsa' : 'gasdsa');
            
            const currentRegion = $('#region').text();
            
            // AJAX 요청
            const data = {
                'code': selectCode,
                'year': year,
                'sdate': sDate,
                'edate': eDate,
                'dongyn': code.length > 5 ? 'Y' : 'N'
            };
            
            $.ajax({
                type: "post",
                url: "/showEnergy",
                data: JSON.stringify(data),
                contentType: 'application/json;',
                success: function(data) {
                    updateChartData(data, dataField, currentRegion);
                },
                error: function(request, status, error) {
                    console.log("code:" + request.status + "\n" + "message:" + request.responseText + "\n" + "error:" + error);
                }
            });
        }
    }
    
  //슬라이더 토글 함수 수정
    window.toggleSlider = function() {
        const sliderButton = document.getElementById("slider-button");
        const sliderTextLeft = document.querySelector(".slider-text-left");
        const sliderTextRight = document.querySelector(".slider-text-right");
        const button1 = document.getElementById("button1");
        const button2 = document.getElementById("button2");
        
        if (sliderButton.style.left === "0px" || sliderButton.style.left === "") {
            // 온실가스 배출량 모드로 전환
            sliderButton.style.left = "182px";
            sliderTextLeft.style.color = "#286E71";
            sliderTextRight.style.color = "#fff";
            button1.textContent = "전기(tCO₂)";
            button2.textContent = "가스(tCO₂)";
        } else {
            // 에너지 사용량 모드로 전환
            sliderButton.style.left = "0px";
            sliderTextLeft.style.color = "#fff";
            sliderTextRight.style.color = "#286E71";
            button1.textContent = "전기(MWh)";
            button2.textContent = "가스(천m³)";
        }
        
        // 테이블 헤더와 데이터 즉시 업데이트
        window.updateTableHeader();
        window.updateDataBasedOnSelection();
    };
});

