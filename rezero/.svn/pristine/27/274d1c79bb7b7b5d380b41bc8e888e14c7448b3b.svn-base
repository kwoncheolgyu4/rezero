	<!-- 툴팁 -->
	<div id="tooltip" class="tooltip"></div>

	<script>

        // document.querySelectorAll('.dong').forEach(path => {
        //     path.addEventListener('mouseenter', () => {
        //         path.parentNode.appendChild(path); // 호버한 요소를 가장 마지막으로 이동
        //     });
        // });

        // DOMContentLoaded 이벤트로 JavaScript 실행 타이밍 보장
        document.addEventListener('DOMContentLoaded', () => {
            // 고정된 층과 움직이는 층 그룹 선택
            const fixedLayer = document.querySelector('.fixed-layer');
            const movingLayer = document.querySelector('.moving-layer');

            // 각 층의 path 요소 가져오기
            const fixedPaths = Array.from(fixedLayer.querySelectorAll('path'));
            const movingPaths = Array.from(movingLayer.querySelectorAll('path'));

            // 고정된 path에 이벤트 추가
            fixedPaths.forEach((fixedPath, index) => {
                const movingPath = movingPaths[index]; // 순서대로 연결

                // 마우스 올릴 때
                fixedPath.addEventListener('mouseenter', () => {
                    if (movingPath) movingPath.classList.add('hovered');
                });

                // 마우스 벗어날 때
                fixedPath.addEventListener('mouseleave', () => {
                    if (movingPath) movingPath.classList.remove('hovered');
                });
            });
        });

        document.querySelectorAll('.fixed-layer .dong').forEach(fixedPath => {
            fixedPath.addEventListener('mouseenter', () => {
                // `id`를 기준으로 연결된 `moving-layer`의 path 찾기
                const id = fixedPath.id;

                // CSS 이스케이프 처리
                const escapedId = CSS.escape(id);

                const movingPath = document.querySelector(`.moving-layer .dong#${escapedId}`);

                if (movingPath) {
                    // `movingPath`를 `moving-layer`의 마지막으로 이동
                    movingPath.parentNode.appendChild(movingPath);
                }
            });
        });

        const tooltip = document.getElementById('tooltip');

        // 이벤트 핸들러 추가
        document.querySelectorAll('path.dong').forEach(path => {
            const name = path.getAttribute('data-name'); // 동 이름

            // 마우스 오버 시 툴팁 표시
            path.addEventListener('mouseover', (evt) => {
                tooltip.style.display = 'block';
                tooltip.textContent = name;
                moveTooltip(evt); // 툴팁 위치 업데이트
            });

            // 마우스 이동 시 툴팁 위치 업데이트
            path.addEventListener('mousemove', (evt) => {
                moveTooltip(evt);
            });

            // 마우스 아웃 시 툴팁 숨김
            path.addEventListener('mouseout', () => {
                tooltip.style.display = 'none';
            });
        });

        // 툴팁 위치 업데이트 함수
        function moveTooltip(evt) {
            tooltip.style.left = evt.pageX + 10 + 'px'; // 마우스 오른쪽 10px
            tooltip.style.top = evt.pageY + 10 + 'px';  // 마우스 아래 10px
        }
    </script>

</body>
</html>
